{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "origins-v2",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist"
  },
  "upload_source_maps": true,
    "vars": {
    "PUBLIC_WORKER_URL": "api.origins.sonderplace.com",
    "ALLOWED_ORIGIN": "https://api.origins.sonderplace.com"
  },
  // Set this to today's date
  "observability": {
    "enabled": true
  }
}
