---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import EventStrip from '../components/EventStrip.astro';
import About from '../components/About.astro';
import Topics from '../components/Topics.astro';
import Outcomes from '../components/Outcomes.astro';
import Facilitator from '../components/Facilitator.astro';
import Testimonials from '../components/Testimonials.astro';
import Tickets from '../components/Tickets.astro';
import Registration from '../components/Registration.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import MobileBuyBar from '../components/MobileBuyBar.astro';
---

<Layout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <EventStrip />
    <About />
    <Topics />
    <Outcomes />
    <Facilitator />
    <Testimonials />
    <Tickets />
    <Registration />
    <FAQ />
    <FinalCta />
  </main>
  <Footer />
  <MobileBuyBar />
</Layout>
