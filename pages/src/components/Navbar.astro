---
interface NavLink {
  href: string;
  label: string;
}

const navLinks: NavLink[] = [
  { href: '#about', label: 'About' },
  { href: '#topics', label: "What we'll cover" },
  { href: '#facilitator', label: 'The Facilitator' },
  { href: '#testimonials', label: 'Testimonials' },
  { href: '#tickets', label: 'Tickets' },
  { href: '#faq', label: 'FAQ' },
];
---

<nav class="nav sticky top-[env(safe-area-inset-top,0px)] z-50 bg-white text-(--ink) border-b border-(--line)" aria-label="Main">
  <div class="wrap flex items-center justify-between gap-4 h-18">
    <a class="logo flex items-center" href="#top">
      <img src="img/origins-logo.png" alt="Origins Business Creativity Workshop" class="h-10 w-auto" />
    </a>
    <ul class="hidden min-[921px]:flex items-center gap-7 list-none m-0 p-0 text-[0.92rem]">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="text-(--muted) hover:text-(--ink) transition-colors no-underline">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn-red py-2.5 px-5 text-[0.88rem]" href="#tickets">Register</a>
  </div>
</nav>
