---
import CurrencyToggle from './CurrencyToggle.astro';
import TicketCard from './TicketCard.astro';
import BundleCard from './BundleCard.astro';
import TeamCard from './TeamCard.astro';

const inPersonPerks = [
  'All eight topics, taught live in the room',
  'Live critique of your business idea',
  'Breakout group work and peer feedback',
  'Workbook and session materials',
  'Breakfast, lunch and refreshments both days',
];

const onlinePerks = [
  'All eight topics, streamed live in HD',
  'Live Q&A and idea feedback through the host',
  'Facilitated online breakout rooms',
  'Digital workbook and session materials',
  'Dedicated online host and tech support',
];

const teamPerks = [
  'Discounted rate for 3+ seats',
  'One invoice for your organisation',
  'Any mix of in-person and online seats',
  'A single point of contact for your team',
];
---

<section class="dark bg-[var(--dark)] text-[var(--on-dark)] py-16 md:py-24" id="tickets">
  <div class="wrap">
    <div class="sec-head mb-12 max-w-[760px] grid gap-4 content-start">
      <p class="eyebrow text-[var(--red-on-dark)]">Tickets</p>
      <h2 class="text-[clamp(1.9rem,4vw,3rem)] font-[var(--head)] font-semibold leading-[1.12] tracking-[-0.02em] text-white">
        Choose how you'll join.
      </h2>
      <p class="lede text-[1.12rem] text-[var(--dark-muted)] max-w-[60ch] leading-relaxed">
        Same programme and same facilitator, in-person or online. Coming with someone? Bundle two tickets and save 10%.
      </p>
    </div>

    <div class="controls flex flex-wrap gap-4 items-center justify-between mb-6">
      <span class="muted text-[var(--dark-muted)] text-[0.95rem]">
        Prices for March 19–20, 2027 · Lagos
      </span>
      <CurrencyToggle defaultCurrency="NGN" />
    </div>

    <p class="group-label font-[var(--head)] font-semibold text-[0.8rem] leading-none tracking-[0.12em] uppercase text-[var(--dark-muted)] my-10 mb-4 flex items-center gap-3">
      Individual tickets
    </p>
    <div class="tk-grid grid grid-cols-1 md:grid-cols-2 gap-5">
      <TicketCard
        type="inperson"
        title="In-person"
        subtitle="Two full days in the room with Leke Alder in Lagos."
        initialPrice="₦800,000"
        badge="Limited seats"
        perks={inPersonPerks}
        buttonText="Select in-person"
        buttonVariant="red"
      />
      <TicketCard
        type="online"
        title="Online"
        subtitle="Join live from anywhere. Past participants joined from 8 countries."
        initialPrice="₦700,000"
        perks={onlinePerks}
        buttonText="Select online"
        buttonVariant="ghost"
      />
    </div>

    <p class="group-label font-[var(--head)] font-semibold text-[0.8rem] leading-none tracking-[0.12em] uppercase text-[var(--dark-muted)] my-10 mb-4 flex items-center gap-3">
      Bundles
    </p>
    <div class="tk-grid grid grid-cols-1 md:grid-cols-2 gap-5">
      <BundleCard
        initialWasPrice="₦1,600,000"
        initialAmtPrice="₦1,440,000"
      />
      <TeamCard
        perks={teamPerks}
        contactEmail="info@sonderplace.com"
      />
    </div>

    <div class="tk-note grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 text-[0.9rem] text-[var(--dark-muted)]">
      <div>
        <b class="block text-[var(--on-dark)] mb-1 font-[var(--head)] font-semibold">Pay in naira or dollars</b>
        Naira prices for payments in Nigeria, dollar prices for international cards.
      </div>
      <div>
        <b class="block text-[var(--on-dark)] mb-1 font-[var(--head)] font-semibold">Bundles are 10% off</b>
        The discount applies to the combined price of both tickets, whatever the mix.
      </div>
      <div>
        <b class="block text-[var(--on-dark)] mb-1 font-[var(--head)] font-semibold">Company invoices</b>
        Paying through your organisation? We can issue an invoice.
      </div>
    </div>
  </div>
</section>
