---
import AttendeeFieldset from './AttendeeFieldset.astro';
import OrderSummary from './OrderSummary.astro';

interface Props {
  workerUrl?: string;
  cohortSubtitle?: string;
  sourceOptions?: string[];
}

const defaultSources = [
  'Instagram',
  'LinkedIn',
  'X (Twitter)',
  'Facebook',
  'WhatsApp',
  'Friend or colleague',
  'A past participant',
  "Leke Alder's website or newsletter",
  'Sonderplace',
  'Other',
];

const {
  workerUrl = import.meta.env.PUBLIC_WORKER_URL || '/submit',
  cohortSubtitle = 'March 19–20, 2027 · Lagos · In-person & online · hosted by Leke Alder',
  sourceOptions = defaultSources,
} = Astro.props;
---

<section id="register" class="py-16 md:py-24">
  <div class="wrap">
    <div class="sec-head mb-12 max-w-[760px] grid gap-4 content-start">
      <p class="eyebrow">Register for Origins</p>
      <h2 class="text-[clamp(1.9rem,4vw,3rem)] font-[var(--head)] font-semibold leading-[1.12] tracking-[-0.02em]">
        Your information
      </h2>
      <p class="lede text-[1.12rem] text-[var(--muted)] max-w-[60ch] leading-relaxed">
        {cohortSubtitle}
      </p>
    </div>

    <div class="success bg-[var(--surface)] border border-[var(--line)] rounded-[10px] p-8 grid gap-[18px] text-[var(--ink)]" id="success" hidden></div>

    <div class="reg-grid grid grid-cols-1 min-[901px]:grid-cols-[1fr_340px] gap-10 items-start">
      <form class="reg-form grid gap-7" id="reg-form" method="POST" action={workerUrl} novalidate>
        <div id="attendees" class="grid gap-7">
          <AttendeeFieldset index={0} label="Your details" defaultAttendance="inperson" />
          <AttendeeFieldset index={1} label="Attendee 2" defaultAttendance="inperson" hidden={true} />
        </div>

        <fieldset class="border border-[var(--line)] rounded-[10px] p-6 m-0 bg-[var(--surface)] min-w-0">
          <legend class="font-[var(--head)] font-semibold text-[1rem] px-2">One last thing</legend>
          <div class="fields grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="field full grid gap-[6px] text-[0.85rem] font-semibold min-w-0 col-span-full">
              <span class="lbl block">
                How did you hear about us? <span class="req text-[var(--red)]" aria-hidden="true">*</span>
              </span>
              <select
                id="f-source"
                name="source"
                required
                class="font-[var(--body)] font-normal text-[0.98rem] p-3 px-[14px] border border-[var(--line)] rounded-lg bg-[var(--paper)] text-[var(--ink)] w-full min-w-0"
              >
                <option value="">Select an option</option>
                {sourceOptions.map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
              <span class="field-err" role="alert" hidden></span>
            </label>
          </div>
        </fieldset>
      </form>

      <OrderSummary />
    </div>
  </div>
</section>
