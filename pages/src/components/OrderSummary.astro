---
interface Props {
  title?: string;
  submitButtonText?: string;
}

const {
  title = 'Order summary',
  submitButtonText = 'Continue to checkout',
} = Astro.props;
---

<aside class="summary sticky top-24 bg-(--dark) text-(--on-dark) rounded-[10px] p-6.5 grid gap-3 text-[0.95rem]" aria-live="polite">
  <h3 class="text-[1.1rem] mb-1 font-semibold text-white">{title}</h3>
  <div id="s-lines" class="grid gap-2.5"></div>
  <div class="row flex justify-between gap-3 text-(--dark-muted)" id="s-disc-row">
    <span>Bundle discount (10%)</span>
    <span id="s-disc"></span>
  </div>
  <div class="row total flex justify-between items-baseline gap-3 border-t border-(--dark-line) pt-3.5 font-semibold text-white">
    <span>Total</span>
    <span id="s-total" class="font-bold text-[1.5rem]"></span>
  </div>
  <button
    class="btn btn-red w-full mt-2"
    type="submit"
    form="reg-form"
    id="pay-btn"
    disabled
  >
    {submitButtonText}
  </button>
  <small id="hint" class="text-(--dark-muted) text-[0.8rem] text-center block">
    Complete all required fields to continue.
  </small>
  <p class="err text-[#FF8A8F] text-[0.88rem] font-semibold m-0" id="err" hidden></p>
</aside>
