---
interface Props {
  number: string;
  title: string;
  description: string;
  tag?: string;
}

const { number, title, description, tag } = Astro.props;
---

<div class="who-card bg-[var(--surface)] border border-[var(--line)] rounded-[10px] p-7 flex flex-col gap-3 content-start">
  <span class="n font-[var(--head)] font-bold text-[2.4rem] leading-none text-[var(--red)] tracking-[-0.03em]">
    {number}
  </span>
  <h4 class="font-[var(--head)] font-semibold text-[1.1rem] leading-[1.3] m-0">
    {title}
  </h4>
  <p class="text-[var(--muted)] text-[0.95rem] leading-relaxed">
    {description}
  </p>
  {tag && (
    <span class="tag self-start font-[var(--head)] font-semibold text-[0.72rem] leading-none tracking-[0.06em] uppercase text-[var(--red)] bg-[#FBEDEC] px-[10px] py-[6px] rounded-full mt-auto">
      {tag}
    </span>
  )}
</div>
