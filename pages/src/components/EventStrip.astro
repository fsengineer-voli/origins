---
interface Fact {
  key: string;
  value: string;
}

const facts: Fact[] = [
  { key: 'Dates', value: 'March 19–20, 2027' },
  { key: 'Location', value: 'Lagos, Nigeria' },
  { key: 'Format', value: 'In-person & online' },
];
---

<section class="strip bg-[var(--red)] text-white py-0" aria-label="Event details">
  <div class="wrap strip-grid grid grid-cols-1 sm:grid-cols-2 min-[861px]:grid-cols-4">
    {facts.map((fact, index) => (
      <div class={`fact grid gap-2 content-center p-5 min-[861px]:p-6 min-[861px]:py-6.5 ${index === 0 ? 'min-[861px]:border-l-0 min-[861px]:pl-0' : 'border-t sm:border-t-0 sm:border-l border-white/25'}`}>
        <span class="k font-[var(--head)] font-semibold text-[0.7rem] leading-none tracking-[0.14em] uppercase text-white/80">
          {fact.key}
        </span>
        <span class="v font-[var(--head)] font-semibold text-[1.15rem] leading-[1.3]">
          {fact.value}
        </span>
      </div>
    ))}
    <div class="fact grid gap-2 content-center p-5 min-[861px]:p-6 min-[861px]:py-6.5 border-t sm:border-t min-[861px]:border-t-0 sm:border-l border-white/25">
      <span class="k font-[var(--head)] font-semibold text-[0.7rem] leading-none tracking-[0.14em] uppercase text-white/80">
        Starts in
      </span>
      <div class="countdown flex gap-4 font-mono tabular-nums items-baseline" aria-label="Time until the workshop">
        <div class="flex items-baseline gap-1">
          <b id="cd-d" class="font-[var(--head)] font-bold text-[1.15rem] leading-[1.3]">--</b>
          <span class="text-[0.72rem] text-white/80 uppercase tracking-[0.06em]">Days</span>
        </div>
        <div class="flex items-baseline gap-1">
          <b id="cd-h" class="font-[var(--head)] font-bold text-[1.15rem] leading-[1.3]">--</b>
          <span class="text-[0.72rem] text-white/80 uppercase tracking-[0.06em]">Hrs</span>
        </div>
        <div class="flex items-baseline gap-1">
          <b id="cd-m" class="font-[var(--head)] font-bold text-[1.15rem] leading-[1.3]">--</b>
          <span class="text-[0.72rem] text-white/80 uppercase tracking-[0.06em]">Min</span>
        </div>
      </div>
    </div>
  </div>
</section>
