---
interface AudienceCard {
  number: string;
  title: string;
  description: string;
  tag?: string;
}

const audienceCards: AudienceCard[] = [
  {
    number: '01',
    title: 'Founders and entrepreneurs',
    description: "You're building something and need clarity on the value proposition, the customer and the brand.",
    tag: '70% of past participants',
  },
  {
    number: '02',
    title: 'Professionals planning a move',
    description: 'You have a job and an idea you keep coming back to. You want to test it properly before you leap.',
  },
  {
    number: '03',
    title: 'Creatives and intrapreneurs',
    description: 'You come up with ideas for a living, or for your organisation, and want a repeatable way to turn them into businesses.',
  },
];
---

<section id="about" class="py-16 md:py-24">
  <div class="wrap">
    <div class="about-top grid grid-cols-1 min-[861px]:grid-cols-[1.05fr_0.95fr] gap-6 min-[861px]:gap-16 items-end pb-14 border-b border-[var(--line)]">
      <div class="sec-head mb-0 max-w-[760px] grid gap-4 content-start">
        <p class="eyebrow">About Origins</p>
        <h2 class="text-[clamp(1.9rem,4vw,3rem)] font-[var(--head)] font-semibold leading-[1.12] tracking-[-0.02em]">
          Most business ideas don't fail in the market. They fail at the origin.
        </h2>
      </div>
      <div class="copy grid gap-4.5">
        <p class="big font-[var(--head)] font-medium text-[clamp(1.2rem,2vw,1.45rem)] leading-[1.5] tracking-[-0.01em]">
          Origins goes back to where every business starts: <em class="not-italic text-[var(--red)]">the idea</em>, the thinking behind it, and the discipline that turns instinct into a concept people will pay for.
        </p>
        <p class="lede text-[1.02rem] text-[var(--muted)] leading-relaxed max-w-[60ch]">
          Over two practical days, you work on your own idea or business, with live exercises and direct feedback from Leke Alder.
        </p>
      </div>
    </div>

    <div class="who-head flex flex-wrap items-baseline justify-between gap-3 mt-12 mb-6">
      <h3 class="text-[1.4rem] font-[var(--head)] font-semibold leading-tight">Who it's for</h3>
      <p class="text-[var(--muted)] text-[0.95rem]">Whether you have a business already or just an idea you can't shake.</p>
    </div>

    <div class="who-grid grid grid-cols-1 min-[861px]:grid-cols-3 gap-5">
      {audienceCards.map((card) => (
        <div class="who-card bg-[var(--surface)] border border-[var(--line)] rounded-[10px] p-7 flex flex-col gap-3 content-start">
          <span class="n font-[var(--head)] font-bold text-[2.4rem] leading-none text-[var(--red)] tracking-[-0.03em]">
            {card.number}
          </span>
          <h4 class="font-[var(--head)] font-semibold text-[1.1rem] leading-[1.3] m-0">
            {card.title}
          </h4>
          <p class="text-[var(--muted)] text-[0.95rem] leading-relaxed">
            {card.description}
          </p>
          {card.tag && (
            <span class="tag self-start font-[var(--head)] font-semibold text-[0.72rem] leading-none tracking-[0.06em] uppercase text-[var(--red)] bg-[#FBEDEC] px-2.5 py-1.5 rounded-full mt-auto">
              {card.tag}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
